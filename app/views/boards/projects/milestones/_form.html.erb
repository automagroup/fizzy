<article class="project-panel__content project-panel__content--form" style="--project-color: <%= project.color %>">
  <header class="project-panel__form-header">
    <div>
      <span class="project-panel__eyebrow"><%= project.name %></span>
      <h2 class="project-panel__title margin-none"><%= milestone.new_record? ? "New milestone" : "Edit milestone" %></h2>
    </div>

    <% if milestone.persisted? %>
      <%= link_to board_project_milestone_path(board, project, milestone),
            class: "btn btn--circle borderless txt-x-small",
            title: "Back to project details",
            data: { turbo_frame: "project_panel", turbo_action: "replace" } do %>
        <%= icon_tag "close" %>
        <span class="for-screen-reader">Back to project details</span>
      <% end %>
    <% else %>
      <button type="button" class="btn btn--circle borderless txt-x-small" title="Close" data-action="dialog#close">
        <%= icon_tag "close" %>
        <span class="for-screen-reader">Close</span>
      </button>
    <% end %>
  </header>

  <%= form_with model: [ board, project, milestone ], class: "project-form",
        data: { turbo_action: ("replace" if milestone.new_record?) } do |form| %>
    <label class="project-form__field">
      <span>Name</span>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "off", class: "input", placeholder: "Design sign-off" %>
    </label>

    <label class="project-form__field">
      <span>Delivery date</span>
      <%= form.date_field :due_on, required: true, class: "input" %>
    </label>

    <p class="project-form__note">
      Milestones use the project color. Their delivery dates can be before or after the project date.
    </p>

    <div class="project-form__actions">
      <button type="button" class="btn" data-action="dialog#close">Cancel</button>
      <%= form.submit milestone.new_record? ? "Create milestone" : "Save changes", class: "btn btn--link" %>
    </div>
  <% end %>

  <% if milestone.persisted? %>
    <div class="project-form__danger">
      <%= button_to board_project_milestone_path(board, project, milestone), method: :delete,
            class: "btn txt-negative borderless txt-small",
            data: { turbo_confirm: "Delete this milestone? Its cards will stay in the project without a milestone." },
            form: { data: { turbo_action: "replace" } } do %>
        <%= icon_tag "trash" %>
        <span>Delete milestone</span>
      <% end %>
    </div>
  <% end %>
</article>
