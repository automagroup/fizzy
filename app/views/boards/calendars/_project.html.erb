<%= link_to board_project_path(project.board, project),
      class: "calendar-event calendar-event--project",
      style: "--project-color: #{project.color}",
      title: "Project: #{project.name}",
      aria: { label: "Project: #{project.name}" },
      data: { turbo_frame: "project_panel", turbo_action: "advance" } do %>
  <span class="calendar-event__marker" aria-hidden="true"></span>
  <span class="calendar-event__name"><%= project.name %></span>
<% end %>
